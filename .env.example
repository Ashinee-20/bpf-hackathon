# Local/Cloud Run AI configuration. Vertex uses Application Default Credentials.
AI_GATEWAY_API_KEY=
# Use `vertex` locally and on Cloud Run, or omit for AI Gateway.
AI_MODEL=gemini-2.5-flash
AI_PROVIDER=vertex
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=us-central1
# Required for live opportunity discovery and official-page verification.
FIRECRAWL_API_KEY=
# Set automatically on Cloud Run. When present, Pathwise uses Firestore.
GOOGLE_CLOUD_PROJECT=
NEXT_PUBLIC_APP_NAME=Pathwise
