# Required for live AI responses through Vercel AI Gateway.
AI_GATEWAY_API_KEY=
# Choose a model currently available to your Gateway account.
AI_MODEL=
# Use `vertex` on Cloud Run (Application Default Credentials), or omit for Gateway.
AI_PROVIDER=
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=us-central1
# Required for live opportunity discovery and official-page verification.
FIRECRAWL_API_KEY=
# Set automatically on Cloud Run. When present, Pathwise uses Firestore.
GOOGLE_CLOUD_PROJECT=
NEXT_PUBLIC_APP_NAME=Pathwise
